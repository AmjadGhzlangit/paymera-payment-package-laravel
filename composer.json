{
  "name": "casper/paymera-laravel",
  "description": "Laravel package for Paymera eGate payment gateway",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/http": "^10.0|^11.0"
  },
  "require-dev": {
    "pestphp/pest": "^2.0",
    "orchestra/testbench": "^8.0|^9.0"
  },
  "autoload": {
    "psr-4": {
      "Casper\\Paymera\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Casper\\Paymera\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Casper\\Paymera\\PaymeraServiceProvider"
      ],
      "aliases": {
        "Paymera": "Casper\\Paymera\\Facades\\Paymera"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
